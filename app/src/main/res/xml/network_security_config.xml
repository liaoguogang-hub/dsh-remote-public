<?xml version="1.0" encoding="utf-8"?>
<!--
  DSH is normally reached over plain HTTP on a LAN address (or through a
  TLS-terminating tunnel). Cleartext is therefore permitted in general, but
  the app never sends the launch token anywhere except the configured base URL.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
